# Required: your Anthropic API key (used by the Claude Agent SDK for the
# agent loop itself and for the built-in WebSearch/WebFetch tools).
ANTHROPIC_API_KEY=sk-ant-...

# Optional but strongly recommended once deployed publicly: shared secret
# required in the X-API-Key header on POST /research. Leave unset for local
# dev to skip auth.
RESEARCH_AGENT_API_KEY=
