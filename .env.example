# Required for running the agent locally (CLI without --api-url, or the API
# server itself). Used by the Claude Agent SDK for the agent loop and the
# built-in WebSearch/WebFetch tools.
ANTHROPIC_API_KEY=sk-ant-...

# Optional but strongly recommended once deployed publicly: shared secret
# required in the X-API-Key header on POST /research. Also used by the CLI
# as the X-API-Key header when calling a deployed instance (see
# RESEARCH_AGENT_API_URL below). Leave unset for local dev to skip auth.
RESEARCH_AGENT_API_KEY=

# Optional: if set, the CLI calls this deployed instance's /research
# endpoint over HTTP instead of running the agent locally — no
# ANTHROPIC_API_KEY needed on the calling machine. e.g.
# https://research-agent-xxxxx.us-central1.run.app
RESEARCH_AGENT_API_URL=
